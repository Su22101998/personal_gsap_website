# Copy to .env.local and fill in. Never commit real keys.

# Contact form (src/app/api/contact/route.js) — https://resend.com
RESEND_API_KEY=
# Where enquiries are delivered
CONTACT_TO_EMAIL=
# Optional: a sender on a domain you've verified in Resend.
# Without it, Resend's test sender is used, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
